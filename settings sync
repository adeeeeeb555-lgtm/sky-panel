"""
settings_sync.py  —  Cog للبوت يستقبل تعديلات لوحة التحكم (Sky Universe)

التحميل في البوت:
    await bot.load_extension("settings_sync")      # أو await bot.add_cog(SettingsSync(bot))

متغيرات البيئة في البوت:
    BOT_API_KEY    نفس القيمة الموجودة في اللوحة
    DASHBOARD_URL  رابط اللوحة (مثال: https://sky-panel-z0b2.onrender.com)
"""
import asyncio
import os

import aiohttp
from discord.ext import commands, tasks

DASHBOARD_URL = os.environ.get("DASHBOARD_URL", "https://sky-panel-z0b2.onrender.com").rstrip("/")
BOT_API_KEY = os.environ["BOT_API_KEY"]
POLL_SECONDS = 5


class SettingsSync(commands.Cog):
    def __init__(self, bot: commands.Bot):
        self.bot = bot
        self.session: aiohttp.ClientSession | None = None
        self.rev = 0
        self.cache: dict[str, dict] = {}   # guild_id -> {page_key: {field: value}}
        self.ready = False

    # ---------- دورة الحياة ----------
    async def cog_load(self):
        self.session = aiohttp.ClientSession(
            headers={"X-API-Key": BOT_API_KEY},
            timeout=aiohttp.ClientTimeout(total=10),
        )
        self.poll.start()

    async def cog_unload(self):
        self.poll.cancel()
        if self.session:
            await self.session.close()

    # ---------- طلبات للوحة ----------
    async def _get(self, path: str, **params):
        try:
            async with self.session.get(f"{DASHBOARD_URL}{path}", params=params) as r:
                if r.status != 200:
                    print(f"[sync] {path} -> HTTP {r.status}")
                    return None
                return await r.json()
        except (aiohttp.ClientError, asyncio.TimeoutError) as e:
            print(f"[sync] connection error: {e}")
            return None

    async def _full_sync(self) -> bool:
        data = await self._get("/api/bot/settings")
        if data is None:
            return False
        self.cache = data["guilds"]
        self.rev = data["rev"]
        self.ready = True
        print(f"[sync] loaded settings for {len(self.cache)} guild(s), rev={self.rev}")
        return True

    # ---------- الاستعلام الدوري ----------
    @tasks.loop(seconds=POLL_SECONDS)
    async def poll(self):
        if not self.ready:
            await self._full_sync()
            return

        data = await self._get("/api/bot/updates", since=self.rev)
        if data is None:
            return

        # اللوحة انصفّرت (restart بدون تخزين دائم) أو فاتنا تحديثات من السجل
        updates = data["updates"]
        if data["rev"] < self.rev or (updates and updates[0]["rev"] > self.rev + 1):
            await self._full_sync()
            return
        if not updates:
            return

        # حدّث الكاش لكل سيرفر تغيّر؛ لو فشل جلب أي واحد نعيد المحاولة بالدورة الجاية
        for gid in {u["guild_id"] for u in updates}:
            g = await self._get(f"/api/bot/settings/{gid}")
            if g is None:
                return
            self.cache[gid] = g["settings"]

        self.rev = data["rev"]
        for u in updates:
            self.bot.dispatch(
                "dashboard_settings_update", int(u["guild_id"]), u["page"], u["changed"]
            )

    @poll.before_loop
    async def _before_poll(self):
        await self.bot.wait_until_ready()

    # ---------- أدوات للـ cogs الثانية ----------
    def page(self, guild_id: int, page: str) -> dict | None:
        """إعدادات صفحة معيّنة. None = عمرها ما انحفظت من اللوحة."""
        return self.cache.get(str(guild_id), {}).get(page)

    def get(self, guild_id: int, page: str, key: str, default=None):
        p = self.page(guild_id, page)
        return default if p is None else p.get(key, default)

    def feature_enabled(self, guild_id: int, page: str, checkbox_key: str, default=True) -> bool:
        """الـ checkbox المطفي ما ينرسل أصلاً، فغيابه = مطفي (لو الصفحة انحفظت)."""
        p = self.page(guild_id, page)
        return default if p is None else checkbox_key in p

    def command_enabled(self, guild_id: int, name: str) -> bool:
        return self.feature_enabled(guild_id, "commands", f"cmd_{name}")

    # ---------- يصير لما تتغير الإعدادات ----------
    @commands.Cog.listener()
    async def on_dashboard_settings_update(self, guild_id: int, page: str, changed: list):
        guild = self.bot.get_guild(guild_id)
        name = guild.name if guild else guild_id
        print(f"[sync] تعديل في السيرفر {name} | الصفحة: {page} | الحقول: {', '.join(changed)}")


async def setup(bot: commands.Bot):
    await bot.add_cog(SettingsSync(bot))
